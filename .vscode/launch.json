{
  // Select a configuration in Run and Debug to start the app with a flavor
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (landing + Railway API)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define",
        "FLAVOR=dev",
        "--dart-define=DAYFI_API_BASE_URL=https://dayfi-api-production.up.railway.app/api/v1"
      ]
    },
    {
      // iOS Simulator / Android emulator on this Mac → API on localhost. DAYFI_API_PORT must match the port printed when you run `npm run dev` (3000 or 3001 if 3000 is in use).
      "name": "Flutter Dev (simulator, local API)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "dev",
        "--dart-define",
        "FLAVOR=dev",
        "--dart-define",
        "DAYFI_API_HOST=127.0.0.1",
        "--dart-define",
        "DAYFI_API_PORT=3001"
      ]
    },
    {
      // Temporary API while api.dayfi.co (Hetzner) is down — auth/signup work; FW/YC need static IP on VPS.
      "name": "Flutter Dev (Railway API)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "dev",
        "--dart-define",
        "FLAVOR=dev",
        "--dart-define=DAYFI_API_BASE_URL=https://dayfi-api-production.up.railway.app/api/v1"
      ]
    },
    {
      // Production API on Hetzner (api.dayfi.co) — use to test Flutterwave / Yellow Card from the app.
      "name": "Flutter Dev (api.dayfi.co)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "dev",
        "--dart-define",
        "FLAVOR=dev",
        "--dart-define=DAYFI_API_BASE_URL=https://api.dayfi.co/api/v1"
      ]
    },
    {
      // Physical phone: prompts for your Mac’s Wi‑Fi IP (not 192.168.x.1 — that is usually the router). Terminal: ipconfig getifaddr en0
      "name": "Flutter Dev (physical phone, Wi‑Fi / LAN)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "dev",
        "--dart-define",
        "FLAVOR=dev",
        "--dart-define=DAYFI_API_HOST=${input:dayfiMacLanIp}",
        "--dart-define",
        "DAYFI_API_PORT=${input:dayfiApiPort}"
      ]
    },
    {
      "name": "Flutter Pilot (Railway API — temp)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "pilot",
        "--dart-define",
        "FLAVOR=pilot",
        "--dart-define=DAYFI_API_BASE_URL=https://dayfi-api-production.up.railway.app/api/v1"
      ]
    },
    {
      "name": "Flutter Pilot (api.dayfi.co)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "pilot",
        "--dart-define",
        "FLAVOR=pilot"
      ]
    },
    {
      "name": "Flutter Prod (api.dayfi.co)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "prod",
        "--dart-define",
        "FLAVOR=prod"
      ]
    }
  ],
  "inputs": [
    {
      "id": "dayfiMacLanIp",
      "type": "promptString",
      "description": "Mac Wi‑Fi IP (same network as phone). Run: ipconfig getifaddr en0 — do NOT use x.x.x.1 (router).",
      "default": ""
    },
    {
      "id": "dayfiApiPort",
      "type": "promptString",
      "description": "Backend port (must match DAYFI_PORT in dayfi_backend .env, often 3000 or 3001).",
      "default": "3001"
    }
  ]
}
